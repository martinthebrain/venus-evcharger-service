# Doxygen configuration for venus-evcharger-service.

PROJECT_NAME           = "venus-evcharger-service"
PROJECT_BRIEF          = "EV charger control and Venus OS integration"
OUTPUT_DIRECTORY       = build/doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English

FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
JAVADOC_AUTOBRIEF      = YES
PYTHON_DOCSTRING       = YES
OPTIMIZE_OUTPUT_JAVA   = YES
EXTENSION_MAPPING      = py=Python

INPUT                  = README.md \
                         API_OPERATOR_GUIDE.md \
                         API_OVERVIEW.md \
                         API_VERSIONING.md \
                         CONTRIBUTING.md \
                         INSTALL.md \
                         CONFIGURATION.md \
                         CHARGER_BACKENDS.md \
                         CONTROL_API.md \
                         DBUS_GATEWAY.md \
                         DBUS_INTROSPECTION.md \
                         DEV_API_WORKFLOW.md \
                         DIAGNOSTICS.md \
                         ENERGY_RECOMMENDATION_SCHEMA.md \
                         HUAWEI_INTEGRATION.md \
                         RELEASE_PROCESS.md \
                         SECURITY.md \
                         SHELLY_PROFILES.md \
                         STATE_API.md \
                         STATE_MODEL.md \
                         TROUBLESHOOTING.md \
                         UPDATE_FLOW.md \
                         VENUS_DBUS_SURFACE.md \
                         docs/DEVELOPER_DOCUMENTATION.md \
                         build/doxygen/generated/function_inventory.md \
                         venus_evcharger \
                         venus_evcharger_service.py \
                         venus_evcharger_observer.py \
                         venus_evcharger_dbus_adapter.py \
                         venus_evcharger_auto_input_helper.py \
                         venus_evcharger_generic_shelly_configuration.py \
                         venus_evchargerctl.py \
                         scripts/ops
FILE_PATTERNS          = *.py *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */__pycache__/* \
                         */build/* \
                         */mutants/* \
                         */tests/* \
                         */.venv-*/*

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PRIV_VIRTUAL   = YES
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
INTERNAL_DOCS          = YES

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = README.md

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = NO
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS

FILTER_PATTERNS        = *.py="python3 scripts/dev/doxygen_python_filter.py"
FILTER_SOURCE_FILES    = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = YES

GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml

HAVE_DOT               = NO
