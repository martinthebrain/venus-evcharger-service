#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later

# External read-only forensic observer for the EV charger service.

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" >/dev/null 2>&1 && pwd)
REPO_DIR=$(realpath "$SCRIPT_DIR/../../..")
CONFIG_PATH="$REPO_DIR/deploy/venus/config.venus_evcharger.ini"
OBSERVER_BINARY="$REPO_DIR/deploy/venus/bin/venus-evcharger-forensic-observer"
exec 2>&1

if [ ! -x "$OBSERVER_BINARY" ]; then
	echo "Forensic observer binary is missing or not executable: $OBSERVER_BINARY" >&2
	exit 1
fi

exec "$OBSERVER_BINARY" "$CONFIG_PATH"
