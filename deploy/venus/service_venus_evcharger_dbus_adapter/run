#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later

# Dedicated Victron DBus adapter for the EV charger service.

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" >/dev/null 2>&1 && pwd)
REPO_DIR=$(realpath "$SCRIPT_DIR/../../..")
CONFIG_PATH="$REPO_DIR/deploy/venus/config.venus_evcharger.ini"
DBUS_ADAPTER_BINARY="$REPO_DIR/deploy/venus/bin/venus-evcharger-dbus-adapter"
exec 2>&1

if [ ! -x "$DBUS_ADAPTER_BINARY" ]; then
	echo "Native DBus adapter binary is missing or not executable: $DBUS_ADAPTER_BINARY" >&2
	exit 1
fi

exec "$DBUS_ADAPTER_BINARY" "$CONFIG_PATH"
