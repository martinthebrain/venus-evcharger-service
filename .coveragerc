[run]
branch = True
source =
    venus_evcharger
    venus_evcharger_auto_input_helper
    venus_evcharger_dbus_adapter
    venus_evcharger_observer
    venus_evcharger_service
    venus_evchargerctl

[report]
show_missing = True
skip_empty = True
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    if typing.TYPE_CHECKING:
    # Protocol bodies are declarative type contracts, not runtime branches.
    class .*\(.*Protocol.*\):
    ^\s*Protocol,?$

[xml]
output = coverage.xml
