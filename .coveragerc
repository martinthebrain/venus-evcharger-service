[run]
source = .
omit =
    tests/*
    .github/*
    examples/*
    scripts/*
    venus_evcharger/backend/cerbo_gx_relay_switch.py
    venus_evcharger/dbus_adapter_process_protocols.py
    venus_evcharger/inputs/helper/sources_dbus.py
    venus_evcharger/inputs/helper/subscriptions.py
    venus_evcharger/inputs/pv.py
    venus_evcharger/ops/*
    venus_evcharger/ports/dbus.py
    venus_evcharger/runtime/async_mainloop.py
    venus_evcharger/runtime/health.py
    venus_evcharger/runtime/setup.py
    venus_evcharger/update/victron_ess_balance_apply_support.py
    venus_evcharger_auto_input_helper.py

[report]
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    if typing.TYPE_CHECKING:
omit =
    tests/*
    .github/*
    */__pycache__/*
    examples/*
    scripts/*
    venus_evcharger/backend/cerbo_gx_relay_switch.py
    venus_evcharger/dbus_adapter_process_protocols.py
    venus_evcharger/inputs/helper/sources_dbus.py
    venus_evcharger/inputs/helper/subscriptions.py
    venus_evcharger/inputs/pv.py
    venus_evcharger/ops/*
    venus_evcharger/ports/dbus.py
    venus_evcharger/runtime/async_mainloop.py
    venus_evcharger/runtime/health.py
    venus_evcharger/runtime/setup.py
    venus_evcharger/update/victron_ess_balance_apply_support.py
    venus_evcharger_auto_input_helper.py
